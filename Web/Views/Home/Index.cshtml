@{
    ViewBag.Title = "Home Page";
}

<div class="jumbotron">
    <h1>Sistema de Gestión de productos y pedidos</h1>
    <p class="lead">Seleccione una de las siguientes secciones.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="panel panel-default text-center" style="box-shadow: 0 4px 8px rgba(0,0,0,0.1); border-radius: 6px;">
            <div class="panel-body" style="padding: 30px 15px;">
                <div style="font-size: 45px; color: #3498db; margin-bottom: 15px;">
                </div>
                <h3>Clientes</h3>
                <hr />
                @Html.ActionLink("Ir a Clientes", "Index", "Clientes", null, new { @class = "btn btn-primary btn-block btn-lg" })
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="panel panel-default text-center" style="box-shadow: 0 4px 8px rgba(0,0,0,0.1); border-radius: 6px;">
            <div class="panel-body" style="padding: 30px 15px;">
                <div style="font-size: 45px; color: #2ecc71; margin-bottom: 15px;">
                </div>
                <h3>Productos</h3>                
                <hr />
                @Html.ActionLink("Ir a Productos", "Index", "Productos", null, new { @class = "btn btn-success btn-block btn-lg" })
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="panel panel-default text-center" style="box-shadow: 0 4px 8px rgba(0,0,0,0.1); border-radius: 6px;">
            <div class="panel-body" style="padding: 30px 15px;">
                <div style="font-size: 45px; color: #e67e22; margin-bottom: 15px;">
                </div>
                <h3>Pedidos</h3>
                <hr />
                <div class="row">
                    <div class="col-xs-6">
                        @Html.ActionLink("Ver Lista", "Index", "Pedidos", null, new { @class = "btn btn-warning btn-block" })
                    </div>
                    <div class="col-xs-6">
                        @Html.ActionLink("Nuevo Pedido", "Create", "Pedidos", null, new { @class = "btn btn-danger btn-block" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>